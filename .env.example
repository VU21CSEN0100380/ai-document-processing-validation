APP_ENV=development
# Vercel: connect an external PostgreSQL provider (for example Neon).
# Both postgres:// and postgresql:// URLs are normalized to psycopg automatically.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/docai
UPLOAD_DIR=uploads
LOG_DIR=logs
MAX_UPLOAD_BYTES=10485760
# Docker/local default: tesseract. Vercel default: rapidocr. Also accepts auto.
OCR_MODE=tesseract
TESSERACT_CMD=
LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

